# Regulus Automation Inc. — environment variables (example)
# Copy to `.env.local` and fill in as needed. NEVER commit real secrets.
# The site builds and runs with NO variables set; all below are optional.

# --- Public (safe to expose; compiled into the client bundle) -----------------

# Canonical site origin. If unset, the value in src/lib/site.ts is used.
# Used for canonical URLs, sitemap, robots, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://regulusautomation.ca

# --- Build / tooling ----------------------------------------------------------

# Disable Next.js anonymous telemetry during CI/builds.
NEXT_TELEMETRY_DISABLED=1

# --- Optional: contact backend (not required for the current mailto flow) -----
# Only needed if you wire src/app/api/contact to a real handler (see CONTENT.md).
# These are SERVER-side (no NEXT_PUBLIC_ prefix) — keep any real value secret.

# POST target for server-side contact submissions (email/CRM webhook).
# CONTACT_ENDPOINT=

# Shared secret / API key for the contact endpoint (SECRET — never hard-code).
# CONTACT_API_KEY=

# --- Inbound lead capture (/api/leads) --------------------------------------
# Required in production. Used only to hash privacy-safe rate-limit and duplicate
# keys — never stored in plaintext. Minimum 32 characters. If unset, the route
# fails closed (503) rather than storing anything.
# LEAD_RATE_LIMIT_SALT=minimum-32-random-bytes
# Optional best-effort notification (durable Netlify Blob storage is authoritative).
# LEAD_NOTIFICATION_WEBHOOK_URL=https://maintainer-controlled.example/notify
# LEAD_NOTIFICATION_WEBHOOK_TOKEN=server-only-bearer-token

# --- AI Receptionist (/api/receptionist) ------------------------------------
# Required in production for privacy-safe rate-limit/idempotency keys. Falls back
# to LEAD_RATE_LIMIT_SALT if unset; if neither is set the route fails closed
# (503). Minimum 32 characters.
# RECEPTIONIST_RATE_LIMIT_SALT=minimum-32-random-bytes
#
# Model provider — CONFIG, NOT CODE. Default is the deterministic, network-free
# adapter (production runs on it). To enable a live model later:
# RECEPTIONIST_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...           # SECRET — server-only, never committed
# RECEPTIONIST_MODEL_ID=claude-sonnet-5  # optional override
# RECEPTIONIST_MODEL_TIMEOUT_MS=12000    # optional; falls back to deterministic on timeout
#
# Optional best-effort notification (falls back to LEAD_NOTIFICATION_WEBHOOK_*).
# RECEPTIONIST_NOTIFICATION_WEBHOOK_URL=https://maintainer-controlled.example/notify
# RECEPTIONIST_NOTIFICATION_WEBHOOK_TOKEN=server-only-bearer-token
